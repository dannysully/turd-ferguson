# AlwaysCited environment variables
# Copy to .env.local and fill in real values before deploying

# Email destination for contact form submissions
CONTACT_EMAIL_DESTINATION=hello@alwayscited.com

# Resend API key. REQUIRED - without it the contact form and the scan request
# form both return an error instead of sending. Get your key at resend.com,
# then set it in the Vercel project environment variables.
RESEND_API_KEY=

# Sender address. Must be on a domain verified in Resend. The default
# onboarding@resend.dev only delivers to your own Resend account address, so
# set this to something on alwayscited.com once the domain is verified.
SCAN_FROM_EMAIL="alwayscited <hello@alwayscited.com>"

# Production URL (used for canonical URLs, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://alwayscited.com
